# SAP ADT MCP Server (sap-adt) - conexiones SAP
# 1. Copia este archivo como .env (en la misma carpeta que index.js)
# 2. Pon tu usuario y contrasena SAP en "user" y "password"
# 3. El JSON debe quedar en UNA sola linea
# El archivo .env NO se sube a Git (esta en .gitignore). NO lo compartas.
#
# Para varias conexiones agrega mas objetos al arreglo, ej:
# SAP_CONNECTIONS=[{"alias":"DEV",...},{"alias":"QAS",...}]
# y cambia entre ellas con la herramienta sap_switch_client.

SAP_CONNECTIONS=[{"alias":"DEV","host":"18.219.205.131","port":"44300","protocol":"https","client":"100","user":"","password":""}]
